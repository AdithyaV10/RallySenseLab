# Copy to an ignored local file; replace every CHANGE_ME before validation.
# Mode A = demo_readonly with fresh approved fixture-only volumes and IDs.
# Mode B = local, authenticated controlled research workspace.
APP_MODE=demo_readonly
DEMO_SESSION_IDS=CHANGE_ME_APPROVED_FIXTURE_IDS
POSTGRES_PASSWORD=CHANGE_ME_UNIQUE_DATABASE_PASSWORD
LOCAL_TOKEN=CHANGE_ME_RANDOM_INTERNAL_TOKEN_AT_LEAST_32_CHARACTERS
SITE_ACCESS_PASSWORD=CHANGE_ME_RANDOM_WORKSPACE_PASSWORD_AT_LEAST_20_CHARACTERS
BUILD_ID=CHANGE_ME_REVIEWED_COMMIT
API_IMAGE=rallysense-api:CHANGE_ME_REVIEWED_COMMIT
WEB_IMAGE=rallysense-web:CHANGE_ME_REVIEWED_COMMIT
RALLYSENSE_DOMAIN=lab.example.invalid
WEB_ALLOWED_HOSTS=lab.example.invalid
WEB_ALLOWED_ORIGINS=https://lab.example.invalid
